# Keep the same-origin /api/v1 default in development; Vite proxies /api to
# this non-secret local service target. The packaged platform fixes its API
# base at /api/v1 and does not use CORS.
VITE_SELENE_API_PROXY_TARGET=http://127.0.0.1:8000
# Comma-separated HTTPS object-storage hosts eligible for artifact rendering.
# Leave empty until an operator explicitly approves actual storage hosts.
VITE_SELENE_ARTIFACT_HOSTS=
