{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://selene-xr.invalid/schemas/provenance-manifest.schema.json",
  "title": "Provenance manifest",
  "description": "Hashes, sizes, media types, schemas, input and reference versions, control realisation, parameters, models, dependencies, code revision, environment, and limitations for a complete output bundle. Implementation plan WP-09 task 7.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "created_utc", "artifacts", "inputs", "reference_bundle", "control", "parameters", "models", "dependencies", "code_revision", "environment", "environment_id", "limitations"],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "manifest_id": {"type": "string", "minLength": 1},
    "created_utc": {"type": "string", "format": "date-time"},
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/input"}},
    "reference_bundle": {"$ref": "#/$defs/identity"},
    "control": {"$ref": "#/$defs/control"},
    "parameters": {"$ref": "#/$defs/parameter_snapshot"},
    "models": {"$ref": "#/$defs/component_declaration"},
    "dependencies": {"$ref": "#/$defs/component_declaration"},
    "code_revision": {"type": "string", "minLength": 1},
    "environment": {"$ref": "#/$defs/environment"},
    "environment_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["relative_path", "sha256", "size_bytes", "media_type"],
      "properties": {
        "relative_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "size_bytes": {"type": "integer", "minimum": 0},
        "media_type": {"type": "string", "minLength": 1}, "schema_id": {"type": ["string", "null"]}
      }
    },
    "versioned_component": {
      "type": "object", "additionalProperties": false, "required": ["name", "version"],
      "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}}
    },
    "component_declaration": {
      "oneOf": [
        {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/versioned_component"}},
        {"type": "object", "additionalProperties": false, "required": ["none_reason"], "properties": {"none_reason": {"type": "string", "minLength": 1}}}
      ]
    },
    "input": {
      "type": "object", "additionalProperties": false, "required": ["input_id", "version", "sha256"],
      "properties": {"input_id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "identity": {
      "type": "object", "additionalProperties": false, "required": ["id", "version"],
      "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}
    },
    "control": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["status", "id", "version"], "properties": {"status": {"const": "available"}, "id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["status", "none_reason"], "properties": {"status": {"const": "unavailable"}, "none_reason": {"type": "string", "minLength": 1}}}
      ]
    },
    "parameter_snapshot": {
      "type": "object", "additionalProperties": false, "required": ["parameter_set_id", "version", "values"],
      "properties": {
        "parameter_set_id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1},
        "values": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {
          "matching": {"$ref": "#/$defs/matching_parameters"}, "selection": {"$ref": "#/$defs/selection_parameters"}, "refinement": {"$ref": "#/$defs/refinement_parameters"}
        }}
      }
    },
    "matching_parameters": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {"window_size_px": {"type": "integer", "minimum": 3}, "minimum_score": {"type": "number", "minimum": -1, "maximum": 1}, "search_radius_px": {"type": "number", "exclusiveMinimum": 0}}
    },
    "selection_parameters": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {"minimum_separation_px": {"type": "number", "exclusiveMinimum": 0}, "minimum_coverage_fraction": {"type": "number", "minimum": 0, "maximum": 1}}
    },
    "refinement_parameters": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {"maximum_iterations": {"type": "integer", "minimum": 1}, "convergence_tolerance_px": {"type": "number", "exclusiveMinimum": 0}}
    },
    "environment": {
      "type": "object", "additionalProperties": false, "required": ["python_version", "platform", "dependency_versions"],
      "properties": {"python_version": {"type": "string", "minLength": 1}, "platform": {"type": "string", "minLength": 1}, "dependency_versions": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}}}
    }
  }
}
