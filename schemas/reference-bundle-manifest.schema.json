{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://selene-xr.invalid/schemas/reference-bundle-manifest.schema.json",
  "title": "Reference bundle manifest",
  "description": "Exact image references, terrain sources, control sources, albedo and photometry sources, coverage masks, uncertainty layers, resampling choices, and version identifiers. The schema must distinguish image reference from geodetic control and state which source supports each accuracy claim. Implementation plan section 6.3.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "image_references", "coverage_masks"],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "bundle_id": {"type": "string", "minLength": 1},
    "image_references": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/image_source"}},
    "terrain_sources": {"type": "array", "items": {"$ref": "#/$defs/terrain_source"}},
    "control_sources": {"type": "array", "items": {"$ref": "#/$defs/control_source"}},
    "albedo_sources": {"type": "array", "items": {"$ref": "#/$defs/albedo_source"}},
    "photometry_sources": {"type": "array", "items": {"$ref": "#/$defs/photometry_source"}},
    "coverage_masks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/coverage_mask_source"}},
    "uncertainty_layers": {"type": "array", "items": {"$ref": "#/$defs/uncertainty_source"}},
    "resampling": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "version", "uri", "sha256", "role"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "uri": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "role": {"enum": ["image", "terrain", "control", "albedo", "photometry", "coverage_mask", "uncertainty"]},
        "crs_wkt": {"type": ["string", "null"]}, "units": {"type": ["string", "null"]}
      }
    },
    "image_source": {"allOf": [{"$ref": "#/$defs/source"}, {"type": "object", "properties": {"role": {"const": "image"}}}]},
    "terrain_source": {"allOf": [{"$ref": "#/$defs/source"}, {"type": "object", "properties": {"role": {"const": "terrain"}}}]},
    "albedo_source": {"allOf": [{"$ref": "#/$defs/source"}, {"type": "object", "properties": {"role": {"const": "albedo"}}}]},
    "photometry_source": {"allOf": [{"$ref": "#/$defs/source"}, {"type": "object", "properties": {"role": {"const": "photometry"}}}]},
    "coverage_mask_source": {"allOf": [{"$ref": "#/$defs/source"}, {"type": "object", "properties": {"role": {"const": "coverage_mask"}}}]},
    "uncertainty_source": {"allOf": [{"$ref": "#/$defs/source"}, {"type": "object", "properties": {"role": {"const": "uncertainty"}}}]},
    "control_source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "version", "uri", "sha256", "role", "supports_accuracy_claims", "control_uncertainty_m"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "uri": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "role": {"const": "control"}, "crs_wkt": {"type": ["string", "null"]}, "units": {"type": ["string", "null"]},
        "supports_accuracy_claims": {"type": "boolean"}, "control_uncertainty_m": {"type": ["number", "null"], "exclusiveMinimum": 0}, "control_uncertainty_reason": {"type": ["string", "null"]}
      },
      "allOf": [
        {"if": {"properties": {"supports_accuracy_claims": {"const": true}}, "required": ["supports_accuracy_claims"]}, "then": {"properties": {"control_uncertainty_m": {"type": "number", "exclusiveMinimum": 0}}, "required": ["control_uncertainty_m"]}},
        {"if": {"properties": {"supports_accuracy_claims": {"const": false}}, "required": ["supports_accuracy_claims"]}, "then": {"properties": {"control_uncertainty_m": {"type": "null"}, "control_uncertainty_reason": {"type": "string", "minLength": 1}}, "required": ["control_uncertainty_m", "control_uncertainty_reason"]}}
      ]
    }
  }
}
