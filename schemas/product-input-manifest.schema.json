{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://selene-xr.invalid/schemas/product-input-manifest.schema.json",
  "title": "Product input manifest",
  "description": "Identity, payload family, file locations and SHA-256 digests, acquisition interval, calibration state, raster shape and dtype and nodata and band metadata, reported GSD, geometry adapter and version, frame and projection and datum realisation and their versions, access and redistribution notes, ingestion warnings, and validation status. Implementation plan section 6.2.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_id", "payload_family", "files", "acquisition", "calibration_state", "raster", "geometry_adapter", "frame", "projection", "datum_realisation", "geometry_validation"],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "product_id": {"type": "string", "minLength": 1},
    "payload_family": {"enum": ["OHRC", "TMC-2", "IIRS", "LROC_NAC", "SELENE_TC", "OTHER"]},
    "mission": {"type": ["string", "null"]},
    "instrument_id": {"type": ["string", "null"]},
    "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "acquisition": {"$ref": "#/$defs/acquisition"},
    "calibration_state": {"enum": ["calibrated", "uncalibrated", "unknown"]},
    "raster": {"$ref": "#/$defs/raster"},
    "reported_gsd_m": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "geometry_adapter": {"$ref": "#/$defs/adapter"},
    "frame": {"$ref": "#/$defs/spatial_reference"},
    "projection": {"$ref": "#/$defs/spatial_reference"},
    "datum_realisation": {"$ref": "#/$defs/spatial_reference"},
    "access_notes": {"type": ["string", "null"]},
    "redistribution_notes": {"type": ["string", "null"]},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "geometry_validation": {"$ref": "#/$defs/geometry_validation"}
  },
  "allOf": [
    {"if": {"properties": {"geometry_adapter": {"properties": {"status": {"const": "validated"}}, "required": ["status"]}}, "required": ["geometry_adapter"]}, "then": {"properties": {"geometry_validation": {"properties": {"validated": {"const": true}}, "required": ["validated"]}}}},
    {"if": {"properties": {"geometry_validation": {"properties": {"validated": {"const": true}}, "required": ["validated"]}}, "required": ["geometry_validation"]}, "then": {"properties": {"geometry_adapter": {"properties": {"status": {"const": "validated"}}, "required": ["status"]}}}}
  ],
  "$defs": {
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["relative_path", "sha256", "size_bytes", "media_type", "role"],
      "properties": {
        "relative_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "media_type": {"type": "string", "minLength": 1},
        "role": {"enum": ["data", "label", "kernel", "calibration", "auxiliary"]}
      }
    },
    "acquisition": {
      "type": "object", "additionalProperties": false,
      "required": ["start_utc", "end_utc"],
      "properties": {"start_utc": {"type": "string", "format": "date-time"}, "end_utc": {"type": "string", "format": "date-time"}}
    },
    "raster": {
      "type": "object", "additionalProperties": false,
      "required": ["shape", "dtype"],
      "properties": {
        "shape": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"type": "integer", "minimum": 1}},
        "dtype": {"type": "string", "minLength": 1},
        "nodata": {"type": ["number", "null"]},
        "bands": {"type": "array", "items": {"$ref": "#/$defs/band"}}
      }
    },
    "band": {
      "type": "object", "additionalProperties": false, "required": ["band_number"],
      "properties": {"band_number": {"type": "integer", "minimum": 1}, "center_wavelength_nm": {"type": ["number", "null"], "exclusiveMinimum": 0}, "fwhm_nm": {"type": ["number", "null"], "exclusiveMinimum": 0}, "is_bad_band": {"type": ["boolean", "null"]}, "spectral_regime": {"enum": ["reflected", "emitted", "unknown", null]}}
    },
    "adapter": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "status"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "status": {"enum": ["validated", "unvalidated", "unknown"]},
        "note": {"type": ["string", "null"]}
      },
      "allOf": [{"if": {"properties": {"status": {"enum": ["unvalidated", "unknown"]}}, "required": ["status"]}, "then": {"required": ["note"], "properties": {"note": {"type": "string", "minLength": 1}}}}]
    },
    "spatial_reference": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "status"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": ["string", "null"]},
        "status": {"enum": ["verified", "unknown", "not_applicable"]},
        "note": {"type": ["string", "null"]}
      },
      "allOf": [{"if": {"properties": {"status": {"const": "unknown"}}, "required": ["status"]}, "then": {"required": ["note"], "properties": {"note": {"type": "string", "minLength": 1}}}}]
    },
    "geometry_validation": {
      "type": "object", "additionalProperties": false, "required": ["validated", "note"],
      "properties": {"validated": {"type": "boolean"}, "note": {"type": "string", "minLength": 1}}
    }
  }
}
