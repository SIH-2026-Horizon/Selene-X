{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://selene-xr.invalid/schemas/parameter-fit-provenance.schema.json",
  "title": "Frozen parameter-fit provenance",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "fit_id", "source_manifest_id", "source_manifest_sha256", "frozen_route_snapshot_sha256", "inputs"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "fit_id": {"type": "string", "pattern": "^pfp-sha256-[0-9a-f]{64}$"},
    "source_manifest_id": {"type": "string", "minLength": 1}, "source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "frozen_route_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "inputs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["product_id", "split_role"], "properties": {"product_id": {"type": "string", "minLength": 1}, "split_role": {"enum": ["train_development", "validation", "held_out_test", "not_applicable"]}}}}
  }
}
