{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://selene-xr.invalid/schemas/metric-report.schema.json",
  "title": "Metric report",
  "description": "One schema serving both the route-qualification report and the scene report, with different applicability rules. A metric that cannot be computed is null with a reason and is never replaced with zero or omitted. Implementation plan section 6.6.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "scope", "computed_utc", "metrics"],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "report_id": {"type": "string", "minLength": 1},
    "scope": {"enum": ["route_qualification", "scene"]},
    "route_id": {"type": ["string", "null"]},
    "product_id": {"type": ["string", "null"]},
    "computed_utc": {"type": "string", "format": "date-time"},
    "metrics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/metric"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "metric": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "value", "units", "evidence_source"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "value": {"type": ["number", "null"]},
        "units": {"type": "string", "minLength": 1},
        "reason": {"type": ["string", "null"]},
        "evidence_source": {"type": "string", "minLength": 1},
        "sample_count": {"type": ["integer", "null"], "minimum": 0},
        "confidence_interval": {"type": ["object", "null"], "additionalProperties": false, "required": ["lower", "upper"], "properties": {"lower": {"type": "number"}, "upper": {"type": "number"}}}
      },
      "allOf": [
        {"if": {"properties": {"value": {"type": "null"}}, "required": ["value"]}, "then": {"required": ["reason"], "properties": {"reason": {"type": "string", "minLength": 1}}}},
        {"if": {"properties": {"value": {"type": "number"}}, "required": ["value"]}, "then": {"properties": {"reason": {"type": "null"}}}}
      ]
    }
  },
  "allOf": [
    {"if": {"properties": {"scope": {"const": "scene"}}, "required": ["scope"]}, "then": {"required": ["product_id"], "properties": {"product_id": {"type": "string", "minLength": 1}}}},
    {"if": {"properties": {"scope": {"const": "route_qualification"}}, "required": ["scope"]}, "then": {"required": ["route_id"], "properties": {"route_id": {"type": "string", "minLength": 1}}}}
  ]
}
