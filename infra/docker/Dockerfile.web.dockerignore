# Dockerfile-specific rules for the root build context used by Dockerfile.web.
# The web build only copies web/ source and the nginx configuration below, so
# do not transmit credentials, data, model artifacts, or generated output to
# the Docker daemon.
.git/
.github/
.venv/
venv/
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/

.env
.env.*
secrets/
*.pem
*.key

data/
model/
kernels/
runs/
artifacts/
outputs/
scratch/
tmp/
benchmarks/
docs/
tests/
train/
packages/
configs/
schemas/

web/node_modules/
web/dist/
infra/compose/
infra/k8s/
