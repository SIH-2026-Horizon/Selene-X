# Copy this file to infra/compose/.env.platform, keep that copy uncommitted,
# and replace both placeholder passwords before using Docker Compose.
#
# Passwords are interpolated into a PostgreSQL URL. Use URL-safe, noncommitted
# values made only of unreserved characters: A-Z, a-z, 0-9, '.', '_', '~', '-'.
POSTGRES_DB=selene
POSTGRES_USER=selene
POSTGRES_PASSWORD=replace_with_a_unique_url_safe_local_password

# The first operator account is provisioned once at service startup. Both
# values stay only in this ignored file; the password is stored as an Argon2id
# hash and is never compiled into the web app or passed through Nginx.
SELENE_BOOTSTRAP_ADMIN_USERNAME=replace_with_a_local_admin_username
SELENE_BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_unique_local_admin_password_at_least_8_characters

# These local development root credentials have no production meaning.
MINIO_ROOT_USER=selene-local
MINIO_ROOT_PASSWORD=replace_with_a_different_unique_url_safe_local_password

# Create this private bucket manually in the loopback-only MinIO console after
# startup. It is deliberately not wired into the service yet.
MINIO_BUCKET=selene-private

# Optional and non-secret. Leave blank unless the operator has explicitly
# approved HTTPS object-storage host names for browser artifact rendering.
# This is compiled into the local web image; it is never an API/CORS setting.
VITE_SELENE_ARTIFACT_HOSTS=

# Named local volumes. Keep these standard names for the normal platform;
# replace them with unique names only when preserving an incompatible volume.
SELENE_PLATFORM_POSTGIS_VOLUME_NAME=selene-xr-platform-postgis-data
SELENE_PLATFORM_MINIO_VOLUME_NAME=selene-xr-platform-minio-data
