server {
    listen 8080 default_server;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Docker Compose may recreate ``service`` without recreating this static
    # web container. Resolve its service name at request time so Nginx does
    # not retain the former container IP and turn the same-origin proxy into
    # a persistent 502 after that routine restart.
    resolver 127.0.0.11 ipv6=off;
    set $selene_service service;

    # All browser-visible service requests stay on this loopback origin. Exact
    # liveness/readiness paths are included for local operations; unknown app
    # paths remain static SPA routes and are never proxied.
    location = /healthz {
        proxy_pass http://$selene_service:8000;
        include /etc/nginx/conf.d/proxy-headers.conf;
        include /etc/nginx/conf.d/security-headers.conf;
        add_header Cache-Control "no-store" always;
    }

    location = /readyz {
        proxy_pass http://$selene_service:8000;
        include /etc/nginx/conf.d/proxy-headers.conf;
        include /etc/nginx/conf.d/security-headers.conf;
        add_header Cache-Control "no-store" always;
    }

    location = /api {
        include /etc/nginx/conf.d/security-headers.conf;
        add_header Cache-Control "no-store" always;
        return 404;
    }

    location /api/ {
        proxy_pass http://$selene_service:8000;
        include /etc/nginx/conf.d/proxy-headers.conf;
        include /etc/nginx/conf.d/security-headers.conf;
        add_header Cache-Control "no-store" always;
    }

    location = /index.html {
        try_files $uri =404;
        include /etc/nginx/conf.d/security-headers.conf;
        add_header Cache-Control "no-store" always;
    }

    location /assets/ {
        try_files $uri =404;
        include /etc/nginx/conf.d/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
        include /etc/nginx/conf.d/security-headers.conf;
        add_header Cache-Control "no-store" always;
    }
}
